# Linkwarden on Railway — env var reference
# The deploy form is zero-field: the two template variables below are
# auto-filled, and every other constant is baked into the image (Dockerfile
# ENV) or composed at boot by entrypoint.sh. Nothing needs typing in.
# Full upstream list: https://docs.linkwarden.app/self-hosting/environment-variables

# --- Template variables (AUTO) ---
NEXTAUTH_URL=                 # https://${{RAILWAY_PUBLIC_DOMAIN}}/api/v1/auth
NEXTAUTH_SECRET=              # ${{secret(32)}}

# --- Baked into the image (Dockerfile ENV) ---
# STORAGE_FOLDER=/data/data   (archived pages, on the linkwarden-archives volume)
# PGDATA=/data/pgdata         (PostgreSQL cluster, on the linkwarden-postgres volume)
# MAX_WORKERS=1               (Chromium archival concurrency cap)
# MEILI_NO_ANALYTICS=true / MEILI_ENV=production

# --- Composed at boot by entrypoint.sh (never on the form) ---
# DATABASE_URL=postgresql://linkwarden@127.0.0.1:5432/linkwarden
#   (single-container Postgres, trust auth on localhost only)
# MEILI_HOST=http://127.0.0.1:7700
# MEILI_MASTER_KEY=<generated once at first boot, persisted on the volume>

# --- Useful optional upstream vars (add in the service Variables panel) ---
# NEXT_PUBLIC_DISABLE_REGISTRATION=true   # close sign-ups after creating your account
# PAGINATION_TAKE_COUNT=                  # links per page
# ARCHIVE_TAKE_COUNT=                     # links archived per worker batch
# BROWSER_TIMEOUT=                        # ms Chromium waits on a page
# MAX_LINKS_PER_USER=                     # per-user link cap
# NEXT_PUBLIC_RSS_POLLING_INTERVAL_MINUTES=
# TEXT_CONTENT_LIMIT=                     # max chars of page text stored per link
# OLLAMA_MODEL= / OPENAI_API_KEY= ...     # AI auto-tagging (see upstream docs)
# SPACES_KEY= ...                         # S3-compatible storage instead of the volume
# EMAIL_SERVER= / EMAIL_FROM=             # SMTP for invites/password reset
# PROXY=                                  # outbound proxy for archiving
# 40+ SSO providers: NEXT_PUBLIC_<PROVIDER>_ENABLED + credentials
# (GitHub, Google, Authentik, Keycloak, OIDC, ...)

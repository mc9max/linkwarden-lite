# Linkwarden on Railway — env var reference
# The deploy form is zero-field: every variable below is auto-filled with a
# ${{...}} expression, and every other constant is baked into the images
# (Dockerfile ENV) or composed at boot by entrypoint.sh. Nothing needs
# typing in. Full upstream list:
# https://docs.linkwarden.app/self-hosting/environment-variables

# --- Template variables (AUTO — all ${{...}} expressions) ---
PGHOST=                       # ${{postgres.RAILWAY_PRIVATE_DOMAIN}}
PGPASSWORD=                   # ${{postgres.POSTGRES_PASSWORD}}
MEILI_HOST=                   # http://${{meilisearch.RAILWAY_PRIVATE_DOMAIN}}:7700
MEILI_MASTER_KEY=              # ${{meilisearch.MEILI_MASTER_KEY}}
NEXTAUTH_URL=                 # https://${{RAILWAY_PUBLIC_DOMAIN}}/api/v1/auth
NEXTAUTH_SECRET=              # ${{secret(32)}}
# postgres service:
#   POSTGRES_PASSWORD=        # ${{secret(16)}}
# meilisearch service:
#   MEILI_MASTER_KEY=         # ${{secret(32)}}

# --- Baked into the images (Dockerfile ENV, never on the form) ---
# app:        STORAGE_FOLDER=/data/data, MAX_WORKERS=1
# postgres:   PGDATA=/var/lib/postgresql/data/pgdata, POSTGRES_USER=linkwarden,
#             POSTGRES_DB=linkwarden
# meilisearch: MEILI_ENV=production, MEILI_NO_ANALYTICS=true

# --- Composed at boot by the app entrypoint.sh ---
# DATABASE_URL=postgresql://linkwarden:${PGPASSWORD}@${PGHOST}:5432/linkwarden

# --- Useful optional upstream vars (add in the service Variables panel) ---
# NEXT_PUBLIC_DISABLE_REGISTRATION=true   # close sign-ups after creating your account
# PAGINATION_TAKE_COUNT=                  # links per page
# ARCHIVE_TAKE_COUNT=                     # links archived per worker batch
# BROWSER_TIMEOUT=                        # ms Chromium waits on a page
# MAX_LINKS_PER_USER=                     # per-user link cap
# NEXT_PUBLIC_RSS_POLLING_INTERVAL_MINUTES=
# TEXT_CONTENT_LIMIT=                     # max chars of page text stored per link
# OLLAMA_MODEL= / OPENAI_API_KEY= ...     # AI auto-tagging (see upstream docs)
# SPACES_KEY= ...                         # S3-compatible storage instead of the volume
# EMAIL_SERVER= / EMAIL_FROM=             # SMTP for invites/password reset
# PROXY=                                  # outbound proxy for archiving
# 40+ SSO providers: NEXT_PUBLIC_<PROVIDER>_ENABLED + credentials
# (GitHub, Google, Authentik, Keycloak, OIDC, ...)
